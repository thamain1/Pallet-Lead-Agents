# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real credentials.

# Supabase ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key. Used by server actions, edge functions, and admin scripts.
SUPABASE_SERVICE_ROLE_KEY=

# SendGrid ------------------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
# Webhook verification (set after configuring Event Webhook in SendGrid)
SENDGRID_WEBHOOK_PUBLIC_KEY=
# ASM (Advanced Suppression Management) group IDs per outreach category
SENDGRID_PICKUP_ASM_GROUP_ID=
SENDGRID_SALES_ASM_GROUP_ID=
SENDGRID_PARTNER_ASM_GROUP_ID=

# Google APIs ---------------------------------------------------------------
# Used for Places (lead discovery), Maps (UI), and Routes (drive-time).
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=

# Gemini --------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# App settings --------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
# Default service radius from the base address (in minutes).
MAX_DRIVE_MINUTES=180
# Business physical mailing address — required in CAN-SPAM email footer.
BUSINESS_PHYSICAL_ADDRESS=
